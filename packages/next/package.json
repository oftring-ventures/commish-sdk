{
  "name": "@commish/next",
  "version": "0.2.3",
  "description": "Next.js referral capture and Stripe metadata helpers for Commish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oftring-ventures/commish-sdk.git",
    "directory": "packages/next"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    ".": {
      "browser": null,
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./pages/handlers": {
      "browser": null,
      "types": "./dist/pages-handlers.d.ts",
      "default": "./dist/pages-handlers.js"
    },
    "./pages/routing": {
      "browser": null,
      "types": "./dist/pages-routing.d.ts",
      "default": "./dist/pages-routing.js"
    }
  },
  "peerDependencies": {
    "@commish/sdk": "0.2.3",
    "next": ">=16.3.8 <17",
    "react": ">=19.2.8 <20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "24.13.3",
    "@commish/sdk": "workspace:*",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  },
  "bin": {
    "commish-next": "./bin/init.mjs"
  }
}
