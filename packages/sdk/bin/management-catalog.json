    "programs.activate": {
      "method": "POST",
      "path": "/api/management/v1/programs.activate",
      "scope": "programs.write",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "termVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "expectedCurrentTermVersion": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedCurrentStatus": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "paused"
            ]
          },
          "programId": {
            "type": "string",
            "pattern": "^prg_[A-Za-z0-9_-]{12,}$"
          }
        },
        "required": [
          "termVersion",
          "expectedCurrentTermVersion",
          "expectedCurrentStatus",
          "programId"
        ],
        "additionalProperties": false
      },
      "response": "application/json"
    },
    "terms.list": {
      "method": "GET",
      "path": "/api/management/v1/terms.list",
      "scope": "terms.read",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,6}$"
          },
          "programId": {
            "type": "string",
            "pattern": "^prg_[A-Za-z0-9_-]{12,}$"
          }
        },
        "required": [
          "programId"
        ],
        "additionalProperties": false
      },
      "response": "application/json"
    },
    "terms.create": {
      "method": "POST",
      "path": "/api/management/v1/terms.create",
      "scope": "terms.write",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "programId": {
            "type": "string",
            "pattern": "^prg_[A-Za-z0-9_-]{12,}$"
          },
          "operationKey": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "terms": {
            "type": "object",
            "properties": {
              "commission": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "percentage"
                      },
                      "basisPoints": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      }
                    },
                    "required": [
                      "type",
                      "basisPoints"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "fixed"
                      },
                      "amount": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "currency": {
                        "type": "string",
                        "const": "usd"
                      }
                    },
                    "required": [
                      "type",
                      "amount",
                      "currency"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "recurrence": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "first_payment"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "fixed_months"
                      },
                      "months": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 120
                      }
                    },
                    "required": [
                      "kind",
                      "months"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "lifetime"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "perSaleCap": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "currency": {
                        "type": "string",
                        "const": "usd"
                      }
                    },
                    "required": [
                      "amount",
                      "currency"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "returnWindowDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 180
              },
              "disclosureText": {
                "type": "string",
                "maxLength": 2000
              },
              "prohibitedClaims": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 280
                }
              },
              "effectiveAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "commission",
              "recurrence",
              "perSaleCap",
              "returnWindowDays",
              "disclosureText",
              "prohibitedClaims",
              "effectiveAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "programId",
          "operationKey",
          "terms"
        ],
        "additionalProperties": false
      },
      "response": "application/json"
    },
