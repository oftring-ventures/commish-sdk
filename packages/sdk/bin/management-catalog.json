{
  "version": 1,
  "protocol": "commish-management-v1",
  "credential": "delegated_management_grant",
  "authorization": {
    "browserConsent": true,
    "integrationKeysAccepted": false,
    "automationReadOnly": true,
    "writeMaximumSeconds": 600,
    "sessionReadMaximumSeconds": 3600,
    "automationMaximumSeconds": 2592000,
    "tokenStorage": "hash_only"
  },
  "grantInput": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "challengeHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "workspaceId": {
        "type": "string",
        "pattern": "^wrk_[A-Za-z0-9_-]{12,}$"
      },
      "applicationId": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^app_[A-Za-z0-9_-]{12,}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "mode": {
        "type": "string",
        "enum": [
          "test",
          "live"
        ]
      },
      "kind": {
        "type": "string",
        "enum": [
          "session",
          "automation"
        ]
      },
      "scopes": {
        "minItems": 1,
        "maxItems": 15,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "resources.read",
            "diagnostics.read",
            "credentials.read",
            "credentials.write",
            "destinations.read",
            "destinations.write",
            "programs.read",
            "programs.write",
            "terms.read",
            "terms.write",
            "invitations.read",
            "invitations.write",
            "webhooks.read",
            "webhooks.write",
            "webhooks.replay"
          ]
        }
      },
      "expiresIn": {
        "type": "integer",
        "minimum": 60,
        "maximum": 2592000
      }
    },
    "required": [
      "challengeHash",
      "workspaceId",
      "applicationId",
      "mode",
      "kind",
      "scopes",
      "expiresIn"
    ],
    "additionalProperties": false
  },
  "operations": {
    "workspace.get": {
      "method": "GET",
      "path": "/api/management/v1/workspace.get",
