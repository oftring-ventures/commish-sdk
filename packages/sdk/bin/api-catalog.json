    "lookupConversion": {
      "method": "GET",
      "path": "/conversions",
      "summary": "Look up a conversion by the payment's external ID",
      "parameters": [
        {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "required": true,
          "name": "externalId",
          "in": "query"
        }
      ],
      "body": null,
      "paginated": false,
      "workspaceKeyOnly": false
    },
    "createConversion": {
      "method": "POST",
      "path": "/conversions",
      "summary": "Record a conversion",
      "parameters": [
        {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "required": true,
          "name": "Idempotency-Key",
          "in": "header"
        }
      ],
      "body": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "programId": {
            "type": "string",
            "pattern": "^prg_[A-Za-z0-9_-]{12,}$"
          },
          "customerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "emailHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "amount": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "usd"
            ]
          },
          "attributionToken": {
            "type": "string",
            "minLength": 16
          },
          "couponCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            },
            "default": {}
          }
        },
        "required": [
          "externalId",
          "programId",
          "customerId",
          "amount",
          "currency",
          "occurredAt"
        ]
      },
      "paginated": false,
      "workspaceKeyOnly": false
    },
