    "identifyCustomer": {
      "method": "POST",
      "path": "/customers/identify",
      "summary": "Identify a customer from pseudonymous aliases",
      "parameters": [
        {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "required": true,
          "name": "Idempotency-Key",
          "in": "header"
        }
      ],
      "body": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9._:-]{1,255}$"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "stripe": {
            "type": "object",
            "properties": {
              "accountId": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^acct_[A-Za-z0-9_]+$"
              },
              "customerId": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^cus_[A-Za-z0-9_]+$"
              },
              "paymentIntentId": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^pi_[A-Za-z0-9_]+$"
              },
              "chargeId": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^ch_[A-Za-z0-9_]+$"
              }
            },
            "required": [
              "accountId"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "paginated": false,
      "workspaceKeyOnly": false
    },
    "createRefund": {
      "method": "POST",
      "path": "/refunds",
      "summary": "Record a full or partial refund",
      "parameters": [
        {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "required": true,
          "name": "Idempotency-Key",
          "in": "header"
        }
      ],
      "body": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "conversionId": {
            "type": "string",
            "pattern": "^cnv_[A-Za-z0-9_-]{12,}$"
          },
          "programId": {
            "type": "string",
            "pattern": "^prg_[A-Za-z0-9_-]{12,}$"
          },
          "amount": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "usd"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "externalId",
          "conversionId",
          "amount",
          "currency",
          "occurredAt"
        ]
      },
      "paginated": false,
      "workspaceKeyOnly": false
    },
    "createInvitation": {
      "method": "POST",
      "path": "/programs/{programId}/invitations",
      "summary": "Invite a creator to a program",
      "parameters": [
        {
          "schema": {
            "type": "string",
            "pattern": "^prg_[A-Za-z0-9_-]{12,}$"
          },
          "required": true,
          "name": "programId",
          "in": "path"
        },
        {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "required": true,
          "name": "Idempotency-Key",
          "in": "header"
        }
      ],
      "body": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "terms": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "percentage"
                    ]
                  },
                  "basisPoints": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                },
                "required": [
                  "type",
                  "basisPoints"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "fixed"
                    ]
                  },
                  "amount": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "usd"
                    ]
                  }
                },
                "required": [
                  "type",
                  "amount",
                  "currency"
                ],
                "additionalProperties": false
              }
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "email"
        ]
      },
      "paginated": false,
      "workspaceKeyOnly": false
    }
  }
