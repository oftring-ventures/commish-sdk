{
  "version": 1,
  "source": "https://commish.sh/openapi.json",
  "operations": {
    "getWebhookDelivery": {
      "method": "GET",
      "path": "/webhook-deliveries/{deliveryId}",
      "summary": "Read one workspace delivery's metadata",
      "parameters": [
        {
          "schema": {
            "type": "string",
            "pattern": "^evt_[A-Za-z0-9_-]{12,}$"
          },
          "required": true,
          "name": "deliveryId",
          "in": "path"
        }
      ],
      "body": null,
      "paginated": false,
      "workspaceKeyOnly": true
    },
    "listWebhookDeliveries": {
      "method": "GET",
      "path": "/webhook-deliveries",
      "summary": "Read workspace delivery metadata",
      "parameters": [
        {
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "required": false,
          "name": "cursor",
          "in": "query"
        },
        {
          "schema": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^whe_[A-Za-z0-9_-]{12,}$"
          },
          "required": false,
          "name": "endpointId",
          "in": "query"
        },
        {
          "schema": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "delivered",
              "failed"
            ]
          },
          "required": false,
          "name": "status",
          "in": "query"
        },
        {
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "required": false,
          "name": "limit",
          "in": "query"
        }
      ],
      "body": null,
      "paginated": true,
      "workspaceKeyOnly": true
    },
    "getPayout": {
