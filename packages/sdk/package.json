{
  "name": "@commish/sdk",
  "version": "0.3.0",
  "description": "Public server, browser and webhook interfaces for Commish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oftring-ventures/commish-sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": null,
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "browser": null,
      "default": "./dist/webhooks.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@types/node": "24.13.3"
  },
  "bin": {
    "commish": "./bin/init.mjs"
  }
}
