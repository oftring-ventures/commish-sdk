{
  "name": "commish-public-packages",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @commish/sdk build && pnpm --filter @commish/next build",
    "lint": "biome ci packages scripts biome.json package.json",
    "test": "node --test 'scripts/*.test.mjs'",
    "format": "biome check --write packages scripts biome.json package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
